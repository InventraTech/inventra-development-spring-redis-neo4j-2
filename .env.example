# PostgreSQL - Aiven
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT - gerar localmente com: openssl rand -base64 32
JWT_SECRET=
# Access token curto (30 min); o app renova com o refresh token
JWT_EXPIRATION_MS=1800000
# Refresh token (30 dias)
JWT_REFRESH_EXPIRATION_MS=2592000000

# Pedido de entrada na cozinha: tempo que um pedido pendente espera antes de expirar
KITCHEN_ACCESS_REQUEST_TTL=7d
# Consultas por hora, por usuário, na busca de cozinha por código
KITCHEN_CODE_LOOKUP_MAX_PER_HOUR=10

# Log de SQL do Hibernate (desligado por padrão; true só em dev)
JPA_SHOW_SQL=false

# Swagger UI / OpenAPI (false para esconder em produção)
SWAGGER_ENABLED=true

# Job diário que marca lotes vencidos como EXPIRED
BATCH_EXPIRATION_JOB_ENABLED=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cloudinary - dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=
REDIS_SSL=true
